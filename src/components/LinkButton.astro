---
// A button/link that degrades gracefully when the link hasn't been added yet.
interface Props { href?: string; class?: string; external?: boolean; }
const { href = '', class: cls = '', external = false } = Astro.props;
const empty = !href || href === '#';
---
{empty ? (
  <span class={`btn ${cls}`} aria-disabled="true" title="Coming soon"><slot /></span>
) : (
  <a class={`btn ${cls}`} href={href} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}><slot /></a>
)}
