---
import site from '../data/site.json';
import LinkButton from './LinkButton.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/why-ai', label: 'Why AI?' },
  { href: '/projects', label: 'Projects' },
  { href: '/research', label: 'Research' },
  { href: '/experience', label: 'Experience' },
  { href: '/blog', label: 'Writing' },
  { href: '/achievements', label: 'Achievements' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<header class="nav" data-nav>
  <div class="nav-inner">
    <a href="/" class="brand" aria-label={`${site.shortName} — home`}>
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="5" cy="6" r="2.2" fill="var(--cyan)" /><circle cx="5" cy="18" r="2.2" fill="var(--text-3)" />
        <circle cx="19" cy="12" r="2.6" fill="var(--text)" />
        <path d="M7 6.6 16.6 11.3M7 17.4l9.6-4.7" stroke="var(--text-3)" stroke-width="1.2" />
      </svg>
      <span>darsh<span class="accent">.</span></span>
    </a>
    <nav class="links" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class:list={[{ active: isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="ext">
      <LinkButton href={site.links.resume} class="btn-ghost small" external>Resume</LinkButton>
      <LinkButton href={site.links.linkedin} class="small" external>LinkedIn ↗</LinkButton>
    </div>
    <button class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-burger>
      <span></span><span></span>
    </button>
  </div>
  <div class="mobile" id="mobile-menu" data-menu hidden>
    {links.map((l, i) => (
      <a href={l.href} class:list={[{ active: isActive(l.href) }]}><span class="mono muted">0{i + 1}</span>{l.label}</a>
    ))}
    <div class="btn-row" style="margin-top:1.5rem">
      <LinkButton href={site.links.resume} external>Resume</LinkButton>
      <LinkButton href={site.links.linkedin} external>LinkedIn ↗</LinkButton>
    </div>
  </div>
</header>

<script>
  function initNav() {
    const nav = document.querySelector('[data-nav]');
    const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!nav || !burger || !menu) return;
    nav.classList.toggle('scrolled', window.scrollY > 12);
    burger.onclick = () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!open));
      burger.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      menu.hidden = open;
      document.body.style.overflow = open ? '' : 'hidden';
    };
  }
  window.addEventListener('scroll', () => {
    document.querySelector('[data-nav]')?.classList.toggle('scrolled', window.scrollY > 12);
  }, { passive: true });
  document.addEventListener('astro:page-load', initNav);
  document.addEventListener('astro:before-swap', () => { document.body.style.overflow = ''; });
</script>

<style>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; transition: background .3s, border-color .3s, backdrop-filter .3s; border-bottom: 1px solid transparent; }
  .nav:global(.scrolled) { background: rgba(6, 8, 14, .78); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom-color: var(--line); }
  .nav-inner { max-width: 1320px; margin: 0 auto; padding: 0 var(--pad); height: 68px; display: flex; align-items: center; gap: 1.5rem; }
  .brand { display: inline-flex; align-items: center; gap: .55rem; font-family: var(--font-mono); font-weight: 500; font-size: 1rem; }
  .links { display: flex; gap: .15rem; margin-left: auto; }
  .links a { font-size: .86rem; color: var(--text-2); padding: .45rem .65rem; border-radius: 999px; transition: color .2s, background .2s; }
  .links a:hover { color: var(--text); }
  .links a.active { color: var(--text); background: var(--surface-2); }
  .ext { display: flex; gap: .4rem; align-items: center; }
  .ext :global(.small) { min-height: 36px; padding: .4rem .9rem; font-size: .84rem; }
  .burger { display: none; margin-left: auto; width: 44px; height: 44px; background: none; border: 1px solid var(--line-strong); border-radius: 50%; cursor: pointer; position: relative; }
  .burger span { position: absolute; left: 13px; right: 13px; height: 1.5px; background: var(--text); transition: transform .3s var(--ease), top .3s; }
  .burger span:first-child { top: 17px; } .burger span:last-child { top: 25px; }
  .burger[aria-expanded='true'] span:first-child { top: 21px; transform: rotate(45deg); }
  .burger[aria-expanded='true'] span:last-child { top: 21px; transform: rotate(-45deg); }
  .mobile { position: fixed; inset: 68px 0 0 0; background: var(--bg); padding: 1.5rem var(--pad) 3rem; overflow-y: auto; border-top: 1px solid var(--line); }
  .mobile > a { display: flex; gap: 1rem; align-items: baseline; padding: .8rem 0; border-bottom: 1px solid var(--line); font-family: var(--font-display); font-size: 1.5rem; color: var(--text-2); }
  .mobile > a.active { color: var(--text); }
  .mobile .mono { font-size: .75rem; }
  @media (max-width: 1180px) {
    .links, .ext { display: none; }
    .burger { display: block; }
    .nav { background: rgba(6, 8, 14, .85); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  }
</style>
