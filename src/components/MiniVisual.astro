---
// Small technical diagrams: net | pipeline | matrix | cv
interface Props { type: string; }
const { type } = Astro.props;
const cells = Array.from({ length: 48 }, (_, i) => ((i * 37) % 11) / 10);
---
<div class="mv" aria-hidden="true">
  {type === 'net' && (
    <svg viewBox="0 0 200 120">
      {[[30, 30], [30, 60], [30, 90]].flatMap(([x1, y1]) => [[100, 20], [100, 50], [100, 80], [100, 100]].map(([x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} />))}
      {[[100, 20], [100, 50], [100, 80], [100, 100]].map(([x1, y1]) => <line x1={x1} y1={y1} x2="170" y2="60" />)}
      {[[30, 30], [30, 60], [30, 90], [100, 20], [100, 50], [100, 80], [100, 100]].map(([x, y]) => <circle cx={x} cy={y} r="5" />)}
      <circle cx="170" cy="60" r="7" class="hot" />
    </svg>
  )}
  {type === 'pipeline' && (
    <svg viewBox="0 0 200 120">
      {['data', 'model', 'user'].map((t, i) => (
        <g><rect x={10 + i * 66} y="42" width="52" height="36" rx="6" class:list={[{ hotr: i === 2 }]} />
        <text x={36 + i * 66} y="64" text-anchor="middle">{t}</text></g>
      ))}
      <path d="M62 60h14M128 60h14" class="arrow" />
    </svg>
  )}
  {type === 'matrix' && (
    <svg viewBox="0 0 200 120">
      {cells.map((v, i) => (
        <rect x={20 + (i % 12) * 14} y={16 + Math.floor(i / 12) * 22} width="11" height="18" rx="2"
          style={`opacity:${0.12 + v * 0.6}`} class:list={[{ hotc: i === 17 || i === 30 }]} />
      ))}
    </svg>
  )}
  {type === 'cv' && (
    <svg viewBox="0 0 200 120">
      {[0, 1, 2, 3, 4].map((i) => <path d={`M${10 + i * 8} 110 Q 100 ${40 + i * 4} ${190 - i * 8} 110`} class="row" />)}
      <rect x="78" y="38" width="44" height="34" class="box" />
      <text x="80" y="34" class="lbl">path 0.94</text>
    </svg>
  )}
</div>
<style>
  .mv { border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--bg-2); padding: .8rem; }
  svg { width: 100%; height: auto; display: block; }
  line, .row { stroke: var(--line-strong); stroke-width: 1; fill: none; }
  circle { fill: var(--bg); stroke: var(--text-3); stroke-width: 1.3; }
  .hot { stroke: var(--cyan); fill: rgba(116,224,236,.15); }
  rect { fill: var(--surface-2); stroke: var(--line-strong); }
  .hotr { stroke: var(--cyan); }
  .hotc { fill: var(--cyan); opacity: 1 !important; stroke: none; }
  text { font-family: var(--font-mono); font-size: 10px; fill: var(--text-2); }
  .arrow { stroke: var(--cyan); stroke-width: 1.5; }
  .box { fill: none; stroke: var(--cyan); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .lbl { fill: var(--cyan); font-size: 8px; }
</style>
