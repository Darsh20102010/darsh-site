---
import site from '../data/site.json';
import LinkButton from './LinkButton.astro';
import StatusBadge from './StatusBadge.astro';
interface Props { title: string; author?: string; note?: string; url?: string; venue?: string; }
const { title, author = site.name, note, url = site.links.paper, venue } = Astro.props;
---
<aside class="pub reveal">
  <div class="mono label">Publication</div>
  <div class="t">{title}</div>
  <div class="a muted">{author} · independently authored</div>
  {venue && <div class="v">{venue}</div>}
  {note && <p class="muted">{note}</p>}
  <div class="btn-row">
    <StatusBadge kind="published" text="Published research" />
    <LinkButton href={url} class="btn-primary" external>Read published paper <span class="arrow">↗</span></LinkButton>
  </div>
</aside>
<style>
  .pub { border: 1px solid var(--line-strong); border-radius: var(--radius); padding: 1.75rem; background:
    linear-gradient(135deg, rgba(74,130,255,.07), transparent 60%), var(--surface); }
  .t { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; margin: .8rem 0 .3rem; }
  .a { font-size: .9rem; margin-bottom: .4rem; }
  .v { font-size: .9rem; color: var(--cyan); margin-bottom: 1.2rem; font-style: italic; }
</style>
