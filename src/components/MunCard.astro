---
interface Props { conference: string; country: string; committee: string; agenda: string[]; awards?: string[]; image?: string; }
const { conference, country, committee, agenda, awards = [] } = Astro.props;
---
<article class="card lift mc reveal">
  <div class="top mono"><span>{conference}</span><span class="accent">{committee}</span></div>
  <h3>Delegate of {country}</h3>
  <ul class="ag">{agenda.map((a) => <li>{a}</li>)}</ul>
  {awards.length > 0 && <ul class="tags">{awards.map((a) => <li class="tag aw">{a}</li>)}</ul>}
</article>
<style>
  .mc { display: flex; flex-direction: column; }
  .top { display: flex; justify-content: space-between; font-size: .74rem; letter-spacing: .12em; text-transform: uppercase; color: var(--text-2); margin-bottom: 1.4rem; }
  .ag { list-style: none; padding: 0; margin: 0 0 1.2rem; flex: 1; }
  .ag li { color: var(--text-2); font-size: .95rem; padding: .3rem 0 .3rem 1.1rem; position: relative; }
  .ag li::before { content: '›'; position: absolute; left: 0; color: var(--cyan); }
  .aw { color: var(--warn); border-color: rgba(242,192,99,.35); }
</style>
