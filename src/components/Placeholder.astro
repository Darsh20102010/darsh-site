---
// Shows an image if `src` is set, otherwise a labelled "computer-vision frame" placeholder.
interface Props { label: string; src?: string; alt?: string; ratio?: string; class?: string; }
const { label, src, alt, ratio = '16 / 10', class: cls = '' } = Astro.props;
---
<figure class={`ph ${cls}`} style={`aspect-ratio:${ratio}`}>
  {src ? (
    <img src={src} alt={alt ?? label} loading="lazy" decoding="async" />
  ) : (
    <div class="ph-empty">
      <span class="c tl" /><span class="c tr" /><span class="c bl" /><span class="c br" />
      <span class="ph-label mono">[ {label} ]</span>
      <span class="ph-meta mono">add image → /public/images</span>
    </div>
  )}
</figure>
<style>
  .ph { margin: 0; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background:
    repeating-linear-gradient(135deg, transparent 0 14px, rgba(150,165,205,.035) 14px 15px), var(--surface); position: relative; }
  .ph img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .ph:hover img { transform: scale(1.03); }
  .ph-empty { position: absolute; inset: 0; display: grid; place-items: center; align-content: center; gap: .4rem; text-align: center; padding: 1rem; }
  .ph-label { color: var(--text-2); font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; }
  .ph-meta { color: var(--text-3); font-size: .7rem; }
  .c { position: absolute; width: 16px; height: 16px; border-color: var(--cyan); border-style: solid; opacity: .7; }
  .tl { top: 12px; left: 12px; border-width: 1.5px 0 0 1.5px; } .tr { top: 12px; right: 12px; border-width: 1.5px 1.5px 0 0; }
  .bl { bottom: 12px; left: 12px; border-width: 0 0 1.5px 1.5px; } .br { bottom: 12px; right: 12px; border-width: 0 1.5px 1.5px 0; }
</style>
