---
// Vertical timeline. items: [{ when, title, text?, tags?, status? }]
interface Item { when: string; title: string; text?: string; tags?: string[]; status?: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
<ol class="tl">
  {items.map((it) => (
    <li class="tl-item reveal">
      <div class="when mono">{it.when}</div>
      <div class="body">
        <h3>{it.title}</h3>
        {it.text && <p>{it.text}</p>}
        {it.tags && <ul class="tags">{it.tags.map((t) => <li class="tag">{t}</li>)}</ul>}
      </div>
    </li>
  ))}
</ol>
<style>
  .tl { list-style: none; margin: 0; padding: 0; position: relative; }
  .tl::before { content: ''; position: absolute; left: 150px; top: 6px; bottom: 6px; width: 1px; background: linear-gradient(var(--cyan), var(--purple) 60%, transparent); opacity: .5; }
  .tl-item { display: grid; grid-template-columns: 150px 1fr; gap: 2.5rem; padding-bottom: 2.75rem; position: relative; }
  .tl-item::after { content: ''; position: absolute; left: 146px; top: 7px; width: 9px; height: 9px; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--cyan); }
  .when { color: var(--cyan); font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; padding-top: .1rem; text-align: right; }
  .body h3 { margin-bottom: .4rem; }
  .body p { margin-bottom: .8rem; }
  @media (max-width: 640px) {
    .tl::before { left: 4px; }
    .tl-item { grid-template-columns: 1fr; gap: .4rem; padding-left: 1.75rem; }
    .tl-item::after { left: 0; }
    .when { text-align: left; }
  }
</style>
