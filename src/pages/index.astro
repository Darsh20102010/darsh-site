---
import Layout from '../layouts/Layout.astro';
import HeroVisual from '../components/HeroVisual.astro';
import LinkButton from '../components/LinkButton.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Pipeline from '../components/Pipeline.astro';
import Placeholder from '../components/Placeholder.astro';
import StatusBadge from '../components/StatusBadge.astro';
import ResearchCard from '../components/ResearchCard.astro';
import BlogCard from '../components/BlogCard.astro';
import site from '../data/site.json';
import home from '../data/home.json';
import researchData from '../data/research.json';
import { getPosts, getProjects, getResearch } from '../lib/content';

const posts = (await getPosts()).slice(0, 3);
const featured = (await getProjects()).find((p) => p.data.featured);
const research = await getResearch();
---
<Layout>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <span class="label reveal">AI / ML · Research · Building</span>
        <p class="greet mono reveal reveal-d1">{home.greeting}</p>
        <h1 class="reveal reveal-d1"><span class="grad-text">{home.headline}</span></h1>
        <p class="sub mono reveal reveal-d2">{home.subheading}</p>
        <p class="intro reveal reveal-d2">{home.intro}</p>
        <div class="btn-row reveal reveal-d3">
          <a class="btn btn-primary" href="/projects">Explore my work <span class="arrow">→</span></a>
          <a class="btn" href="/research">Read my research</a>
        </div>
        <div class="btn-row secondary reveal reveal-d3">
          <LinkButton href={site.links.resume} class="btn-ghost" external>Resume ↗</LinkButton>
          <span class="dot muted">/</span>
          <LinkButton href={site.links.linkedin} class="btn-ghost" external>LinkedIn ↗</LinkButton>
        </div>
      </div>
      <div class="hero-visual reveal reveal-d2"><HeroVisual /></div>
    </div>
    <div class="focus">
      <div class="container focus-row mono">
        {home.focus.map((f, i) => <>{i > 0 && <span class="sep">•</span>}<span>{f}</span></>)}
      </div>
    </div>
  </section>

  <!-- PIPELINE -->
  <section class="section">
    <div class="container">
      <SectionHeader label="Method" title={home.pipelineTitle} />
      <Pipeline steps={home.pipeline} />
    </div>
  </section>

  <!-- FEATURED PROJECT -->
  {featured && (
    <section class="section feat">
      <div class="container">
        <SectionHeader label="Featured project" title={`${featured.data.title}<span class="muted">.</span>`} lead={featured.data.subtitle} />
        <div class="feat-grid">
          <div class="reveal">
            <div class="btn-row" style="margin-bottom:1.2rem"><StatusBadge kind={featured.data.statusKind} text={featured.data.status} /><span class="mono muted role">{featured.data.role}</span></div>
            <p class="lead">{featured.data.description}</p>
            <ul class="feat-list">
              {featured.data.features.map((f, i) => (
                <li><span class="mono muted">{String(i + 1).padStart(2, '0')}</span><div><strong>{f.name}</strong><span>{f.text}</span></div></li>
              ))}
            </ul>
            <div class="btn-row">
              <a class="btn btn-primary" href={`/projects/${featured.id}`}>Read the case study <span class="arrow">→</span></a>
              {featured.data.demo && <a class="btn" href={featured.data.demo} target="_blank" rel="noopener noreferrer">Try it live ↗</a>}
            </div>
          </div>
          <div class="reveal reveal-d1">
            <Placeholder label="Kisan AI interface" src={featured.data.portrait || featured.data.image} ratio="716 / 819" />
          </div>
        </div>
        <div class="feat-pipe"><Pipeline steps={featured.data.pipeline} compact /></div>
      </div>
    </section>
  )}

  <!-- RESEARCH -->
  <section class="section">
    <div class="container">
      <SectionHeader label="Research" title="Asking what models <em>really</em> do." lead={researchData.intro} />
      <div class="grid grid-2">
        {research.map((r) => (
          <ResearchCard href={`/research/${r.id}`} title={r.data.title} status={r.data.status} statusKind={r.data.statusKind} role={r.data.role} description={r.data.description} themes={r.data.themes} />
        ))}
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="section">
    <div class="container">
      <SectionHeader label="The story so far" title={home.storyTitle} lead={home.storyLead} />
      <div class="story">
        {home.story.map((s, i) => (
          <a href={s.href} class="story-item reveal" style={`transition-delay:${(i % 5) * 50}ms`}>
            <span class="mono verb">{s.verb}</span>
            <span class="items">{s.items.map((it) => <span>→ {it}</span>)}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WRITING -->
  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="row-head">
          <SectionHeader label="Latest writing" title="Explaining what I learn." />
          <a class="btn reveal" href="/blog">View all writing <span class="arrow">→</span></a>
        </div>
        <div class="grid grid-3">
          {posts.map((p) => <BlogCard href={`/blog/${p.id}`} title={p.data.title} date={p.data.date} number={p.data.number} category={p.data.category} description={p.data.description} />)}
        </div>
      </div>
    </section>
  )}

  <!-- CLOSING -->
  <section class="section closing">
    <div class="container center">
      <p class="mono label reveal" style="justify-content:center">// output</p>
      <h2 class="reveal">“{home.closing}”</h2>
      <div class="btn-row reveal" style="justify-content:center;margin-top:2rem">
        <a class="btn btn-primary" href="/contact">Let's connect <span class="arrow">→</span></a>
        <a class="btn" href="/about">More about me</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-top: clamp(7.5rem, 13vw, 9.5rem); position: relative; overflow-x: clip; }
  .hero::after { content: ''; position: absolute; width: 680px; height: 680px; right: -180px; top: -120px; z-index: -1;
    background: radial-gradient(circle, rgba(74,130,255,.13), rgba(161,148,255,.05) 45%, transparent 70%); pointer-events: none; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; padding-bottom: 4rem; }
  .greet { color: var(--text-2); font-size: 1rem; margin: 1.6rem 0 .6rem; }
  h1 { max-width: 14ch; }
  .sub { font-size: .82rem; letter-spacing: .06em; color: var(--cyan); margin: 1.2rem 0 1.4rem; }
  .intro { font-size: 1.1rem; max-width: 38rem; margin-bottom: 2rem; }
  .secondary { margin-top: .8rem; gap: .25rem; }
  .dot { font-size: .9rem; }
  .focus { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: rgba(10,15,29,.6); }
  .focus-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .75rem 1.2rem; padding-top: 1.2rem; padding-bottom: 1.2rem; font-size: .8rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-2); }
  .sep { color: var(--cyan); }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { order: -1; }
    .focus-row { justify-content: center; }
  }
  .feat { background: linear-gradient(180deg, transparent, rgba(74,130,255,.04) 40%, transparent); }
  .feat :global(h2) { font-size: clamp(2.8rem, 7vw, 5rem); }
  .role { font-size: .74rem; text-transform: uppercase; letter-spacing: .1em; }
  .feat-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .feat-list { list-style: none; padding: 0; margin: 2rem 0; }
  .feat-list li { display: grid; grid-template-columns: 2.4rem 1fr; padding: .9rem 0; border-top: 1px solid var(--line); }
  .feat-list li:last-child { border-bottom: 1px solid var(--line); }
  .feat-list .mono { font-size: .75rem; padding-top: .2rem; }
  .feat-list strong { display: block; font-weight: 600; }
  .feat-list span:not(.mono) { color: var(--text-2); font-size: .94rem; }
  .feat-pipe { margin-top: 4rem; }
  @media (max-width: 860px) { .feat-grid { grid-template-columns: 1fr; } }
  :global(h2 em) { font-style: normal; color: var(--cyan); }
  .story { display: grid; grid-template-columns: repeat(5, 1fr); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .story-item { padding: 1.4rem 1.2rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: .7rem; min-height: 150px; transition: background .3s; }
  .story-item:nth-child(5n) { border-right: 0; }
  .story-item:nth-last-child(-n+5) { border-bottom: 0; }
  .story-item:hover { background: var(--surface); }
  .verb { color: var(--cyan); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; }
  .items { display: flex; flex-direction: column; gap: .2rem; font-family: var(--font-display); font-weight: 500; font-size: 1.05rem; line-height: 1.3; }
  @media (max-width: 960px) {
    .story { grid-template-columns: repeat(2, 1fr); }
    .story-item { border-right: 1px solid var(--line) !important; border-bottom: 1px solid var(--line) !important; min-height: 0; }
    .story-item:nth-child(2n) { border-right: 0 !important; }
    .story-item:nth-last-child(-n+2) { border-bottom: 0 !important; }
  }
  .row-head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; flex-wrap: wrap; }
  .row-head > .btn { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .closing h2 { max-width: 22ch; margin: 1rem auto 0; font-size: clamp(1.8rem, 4vw, 3rem); }
  .center { text-align: center; }
</style>
