---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import Placeholder from '../../components/Placeholder.astro';
import { getPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p) => ({ params: { id: p.id }, props: { post: p, all: posts } }));
}
const { post, all } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const others = all.filter((p) => p.id !== post.id);
const related = [...others.filter((p) => p.data.category === d.category), ...others.filter((p) => p.data.category !== d.category)].slice(0, 3);
const date = d.date ? d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
---
<Layout title={d.title} description={d.description} image={d.image || undefined}>
  <article>
    <header class="page-hero">
      <div class="container narrow">
        <a href="/blog" class="mono muted back">← All writing</a>
        <div class="meta mono"><span class="accent">{d.category}</span>{d.number && <><span class="muted">·</span><span>Blog No. {String(d.number).padStart(2, '0')}</span></>}{d.date && <><span class="muted">·</span><time datetime={d.date.toISOString()}>{date}</time></>}</div>
        <h1>{d.title}</h1>
        <p class="lead">{d.description}</p>
      </div>
    </header>
    <div class="container narrow">
      {d.image && <Placeholder label="Featured image" src={d.image} alt={d.title} ratio="16 / 8" />}
      <div class="prose body"><Content /></div>
      {d.takeaways.length > 0 && (
        <aside class="take">
          <span class="label">Key takeaways</span>
          <ol>{d.takeaways.map((t) => <li>{t}</li>)}</ol>
        </aside>
      )}
    </div>
  </article>
  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <span class="label">Related posts</span>
        <div class="grid grid-3" style="margin-top:2rem">
          {related.map((p) => <BlogCard href={`/blog/${p.id}`} title={p.data.title} date={p.data.date} number={p.data.number} category={p.data.category} description={p.data.description} />)}
        </div>
      </div>
    </section>
  )}
</Layout>
<style>
  .narrow { max-width: 820px; }
  .back { font-size: .8rem; } .back:hover { color: var(--cyan); }
  .meta { display: flex; gap: .6rem; font-size: .76rem; text-transform: uppercase; letter-spacing: .1em; margin: 2rem 0 1rem; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); max-width: none; }
  .body { margin: 3rem auto 0; font-size: 1.1rem; }
  .take { margin: 3rem 0 2rem; padding: 1.75rem; border: 1px solid var(--line-strong); border-radius: var(--radius); background: linear-gradient(135deg, rgba(116,224,236,.06), transparent 60%), var(--surface); }
  .take ol { margin: 1rem 0 0; padding-left: 1.2rem; }
  .take li { color: var(--text); margin-bottom: .5rem; }
</style>
