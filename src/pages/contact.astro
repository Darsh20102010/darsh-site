---
import Layout from '../layouts/Layout.astro';
import LinkButton from '../components/LinkButton.astro';
import site from '../data/site.json';
const L = site.links;
const items = [
  { k: 'Email', v: L.email ? L.email : '', href: L.email ? `mailto:${L.email}` : '' },
  { k: 'LinkedIn', v: L.linkedin ? 'View profile' : '', href: L.linkedin },
  { k: 'GitHub', v: L.github ? 'View code' : '', href: L.github },
  { k: 'Resume', v: L.resume ? 'Download PDF' : '', href: L.resume },
];
const action = site.contactFormEndpoint || (L.email ? `mailto:${L.email}` : '');
---
<Layout title="Contact" description={`Get in touch with ${site.name}.`}>
  <section class="page-hero">
    <div class="container split">
      <div>
        <span class="label reveal">Contact</span>
        <h1 class="reveal">Let's connect.</h1>
        <p class="lead reveal reveal-d1">I'm always interested in learning, building, discussing ideas, and exploring how technology can solve real-world problems.</p>
        <ul class="links reveal reveal-d2">
          {items.map((i) => (
            <li>
              <span class="mono muted">{i.k}</span>
              {i.href ? <a href={i.href} target={i.k === 'Email' ? undefined : '_blank'} rel="noopener noreferrer">{i.v} ↗</a> : <span class="muted">Coming soon</span>}
            </li>
          ))}
        </ul>
      </div>
      <form class="card form reveal reveal-d1" method="POST" action={action || undefined} enctype={site.contactFormEndpoint ? undefined : 'text/plain'}>
        <label>Name<input name="name" required autocomplete="name" /></label>
        <label>Email<input name="email" type="email" required autocomplete="email" /></label>
        <label>Message<textarea name="message" rows="6" required></textarea></label>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
        {action ? <button class="btn btn-primary" type="submit">Send message <span class="arrow">→</span></button>
          : <LinkButton class="btn-primary">Send message</LinkButton>}
        {!action && <p class="mono muted note">Form not connected yet. Add a free form endpoint in site settings.</p>}
      </form>
    </div>
  </section>
</Layout>
<style>
  .links { list-style: none; padding: 0; margin: 2.5rem 0 0; }
  .links li { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 0; border-top: 1px solid var(--line); }
  .links li:last-child { border-bottom: 1px solid var(--line); }
  .links .mono { font-size: .76rem; text-transform: uppercase; letter-spacing: .12em; }
  .links a:hover { color: var(--cyan); }
  .form { display: flex; flex-direction: column; gap: 1.1rem; padding: 2rem; }
  label { display: flex; flex-direction: column; gap: .45rem; font-family: var(--font-mono); font-size: .74rem; text-transform: uppercase; letter-spacing: .1em; color: var(--text-2); }
  input, textarea { font: inherit; font-family: var(--font-body); font-size: 1rem; text-transform: none; letter-spacing: 0; color: var(--text); background: var(--bg); border: 1px solid var(--line-strong); border-radius: var(--radius-sm); padding: .8rem .9rem; min-height: 48px; transition: border-color .2s; }
  input:focus, textarea:focus { outline: none; border-color: var(--cyan); }
  textarea { resize: vertical; }
  .hp { position: absolute; left: -9999px; }
  .note { font-size: .74rem; margin: 0; }
</style>
