---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Not found">
  <section class="page-hero"><div class="container">
    <span class="label">Error 404</span>
    <h1>This page wasn't in the training data.</h1>
    <p class="lead">The link may be old, or the page may have moved.</p>
    <a class="btn btn-primary" href="/" style="margin-top:1rem">Back home <span class="arrow">→</span></a>
  </div></section>
</Layout>
